# Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Binance API Credentials (Read-only access recommended)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Bot Configuration
TOP_VOLATILE_COINS=20
VOLATILITY_PERIOD=24
MIN_VOLUME_USD=10000000

# Futures Trading Configuration
LEVERAGE=20                    # Default leverage (1-125)
MARGIN_TYPE=CROSSED           # CROSSED or ISOLATED margin

# Timeframes to analyze (comma separated)
TIMEFRAMES=5m,15m,1h,4h

# Analysis Configuration - Stricter for better trade quality
TREND_CONFIRMATION_THRESHOLD=0.75    # 75% trend confirmation
SIGNAL_STRENGTH_THRESHOLD=70         # 70% signal strength minimum

# Scalping Trade Quality Thresholds
MIN_RISK_REWARD_RATIO=2.0            # Minimum 1:2 risk/reward
MIN_INDICATOR_ALIGNMENT=7            # At least 7/10 indicators aligned
MIN_TIMEFRAME_ALIGNMENT=0.7          # 70% timeframe alignment
MIN_PROFIT_POTENTIAL=1.0             # Minimum 1% profit potential

# Notification Settings
ENABLE_TELEGRAM=true
LOG_LEVEL=INFO
