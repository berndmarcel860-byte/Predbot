# Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Binance API Credentials (Read-only access recommended)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Bot Configuration
TOP_VOLATILE_COINS=20
VOLATILITY_PERIOD=24
MIN_VOLUME_USD=10000000

# Timeframes to analyze (comma separated)
TIMEFRAMES=5m,15m,1h,4h

# Analysis Configuration
TREND_CONFIRMATION_THRESHOLD=0.7
SIGNAL_STRENGTH_THRESHOLD=60

# Notification Settings
ENABLE_TELEGRAM=true
LOG_LEVEL=INFO
